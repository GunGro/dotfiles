# ~/.gitconfig_local: identity and machine-specific git settings (included
# from git/gitconfig; not tracked). setup.bash copies this file once.
# Uncomment and fill in. Left unset, git refuses to commit (user.useConfigOnly
# in git/gitconfig) instead of recording a placeholder identity.
# Tip: your GitHub noreply address keeps your mail out of public history.
# [user]
# 	name = Your Name
# 	email = you@example.com

# Persistent credentials instead of the 1 h in-memory cache from git/gitconfig.
# GitHub via the gh CLI (`gh auth login` once):
# [credential "https://github.com"]
# 	helper =
# 	helper = !gh auth git-credential
